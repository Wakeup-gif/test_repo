{
  "manifest_version": 3,
  "name": "US Sign SquareCoil Companion",
  "version": "0.4.0",
  "version_name": "0.4.0 Stable",
  "description": "SquareCoil Job Timer companion with in-widget Light/Dark/Auto appearance controls and versioned update-shell support.",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://ussignandmill.squarecoil.net/*",
    "https://raw.githubusercontent.com/Wakeup-gif/test_repo/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SquareCoil Companion",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://ussignandmill.squarecoil.net/*"],
      "js": ["content/theme-controller.js"],
      "run_at": "document_start"
    }
  ]
}

{
  "manifest_version": 3,
  "name": "US Sign SquareCoil Companion",
  "version": "0.7.1",
  "version_name": "0.7.1 Rebuild B2.1 Fenced Kernel Development",
  "description": "SquareCoil Companion rebuild B2.1 fenced authoritative kernel for Chrome and Edge. Development branch only.",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://ussignandmill.squarecoil.net/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_title": "SquareCoil Companion",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://ussignandmill.squarecoil.net/*"],
      "js": ["dist/content-controller.js"],
      "run_at": "document_start",
      "all_frames": false,
      "match_about_blank": false
    }
  ]
}

{
  "manifest_version": 3,
  "name": "US Sign SquareCoil Companion",
  "version": "0.7.1",
  "version_name": "0.7.1 Chrome Interaction Recovery",
  "description": "SquareCoil Job Timer companion for Edge and Chrome with stale-root recovery, stable interaction controls, Solid/Glass timer finishes, website themes, dark-theme logo, CSV backup/restore, and versioned update support.",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://ussignandmill.squarecoil.net/*",
    "https://raw.githubusercontent.com/Wakeup-gif/test_repo/*",
    "https://i.imgur.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SquareCoil Companion",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://ussignandmill.squarecoil.net/*"],
      "css": ["styles/site-theme.css", "styles/site-theme-v070.css"],
      "js": ["content/theme-controller.js"],
      "run_at": "document_start"
    }
  ]
}

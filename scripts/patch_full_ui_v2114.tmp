from pathlib import Path
import subprocess

scope = Path('tampermonkey/US-Sign-Project-Scope-Workspace.user.js')
subprocess.run(['python', 'scripts/patch_scope_workspace_v120.tmp'], check=True)

result = subprocess.run(['git', 'diff', '--quiet', '--', str(scope)])
if result.returncode == 0:
    raise SystemExit(0)

subprocess.run(['node', '--check', str(scope)], check=True)
subprocess.run(['git', 'diff', '--check'], check=True)
subprocess.run(['git', 'config', 'user.name', 'github-actions[bot]'], check=True)
subprocess.run(['git', 'config', 'user.email', '41898282+github-actions[bot]@users.noreply.github.com'], check=True)
subprocess.run(['git', 'add', str(scope)], check=True)
subprocess.run(['git', 'commit', '-m', 'Polish Scope Workspace glass v1.2.0'], check=True)
subprocess.run(['git', 'push'], check=True)

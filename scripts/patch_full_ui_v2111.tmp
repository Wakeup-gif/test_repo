from pathlib import Path
p=Path('tampermonkey/US-Sign-Full-UI-Theme.user.js')
s=p.read_text(encoding='utf-8')
if '// @version      2.1.12' in s: raise SystemExit(0)
if '// @version      2.1.11' not in s: raise SystemExit('Expected v2.1.11')
s=s.replace('// @version      2.1.11','// @version      2.1.12',1)
s=s.replace('Stable SquareCoil layout with restored icon glyphs, Roxborough display typography, blue glass chrome, and subtle center-panel blur.','Stable SquareCoil layout with restored icons, Roxborough display typography, blue glass chrome, subtle center blur, and highlight-free Description rich text.',1)
block='''\n\n    /* v2.1.12 remove Description rich-text highlight paint */\n    html body #descriptionbox :is(mark,.marker,.highlight,[class*="highlight" i],span[style*="background" i],font[style*="background" i],strong[style*="background" i],b[style*="background" i],em[style*="background" i],u[style*="background" i],[bgcolor]),\n    html body .us-sign-description-panel :is(mark,.marker,.highlight,[class*="highlight" i],span[style*="background" i],font[style*="background" i],strong[style*="background" i],b[style*="background" i],em[style*="background" i],u[style*="background" i],[bgcolor]),\n    html body .us-sign-readable-content :is(mark,.marker,.highlight,[class*="highlight" i],span[style*="background" i],font[style*="background" i],strong[style*="background" i],b[style*="background" i],em[style*="background" i],u[style*="background" i],[bgcolor]){background:transparent!important;background-color:transparent!important;background-image:none!important;box-shadow:none!important;text-shadow:none!important;border:0!important;border-radius:0!important;padding:0!important;}\n    html body #descriptionbox :is([style*="color:red" i],[style*="color: red" i],font[color="red" i],font[color="#ff0000" i]),\n    html body .us-sign-description-panel :is([style*="color:red" i],[style*="color: red" i],font[color="red" i],font[color="#ff0000" i]),\n    html body .us-sign-readable-content :is([style*="color:red" i],[style*="color: red" i],font[color="red" i],font[color="#ff0000" i]){color:#c98b8b!important;-webkit-text-fill-color:#c98b8b!important;background:transparent!important;background-color:transparent!important;background-image:none!important;box-shadow:none!important;text-shadow:none!important;border:0!important;border-radius:0!important;padding:0!important;}\n'''
marker='\n    @media print {'
pos=s.rfind(marker)
if pos<0: raise SystemExit('print marker missing')
s=s[:pos]+block+s[pos:]
p.write_text(s,encoding='utf-8')